{
  "expo": {
    "name": "Task Reminder",
    "slug": "task-reminder",
    "version": "1.0.0",
    "orientation": "portrait",
    "runtimeVersion": "1.0.0",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.taskreminder.app"
    },
    "android": {
      "package": "com.taskreminder.app",
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "scheme": "taskreminder"
  }
}
